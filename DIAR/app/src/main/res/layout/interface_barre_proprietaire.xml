<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomNavigationProprietaire"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:background="@drawable/bg_bottom_nav"
    android:elevation="12dp"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Accueil (actif) -->
    <LinearLayout
        android:id="@+id/nav_prop_accueil"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ic_nav_prop_accueil"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_home"
            app:tint="#1B8A5A" />

        <TextView
            android:id="@+id/tv_nav_prop_accueil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Accueil"
            android:textColor="#1B8A5A"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/indicator_nav_prop_accueil"
            android:layout_width="56dp"
            android:layout_height="3dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_nav_indicator" />
    </LinearLayout>

    <!-- Mes annonces -->
    <LinearLayout
        android:id="@+id/nav_prop_annonces"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ic_nav_prop_annonces"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_building"
            app:tint="#64748B" />

        <TextView
            android:id="@+id/tv_nav_prop_annonces"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Mes demandes "
            android:textColor="#64748B"
            android:textSize="12sp" />

        <View
            android:id="@+id/indicator_nav_prop_annonces"
            android:layout_width="56dp"
            android:layout_height="3dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_nav_indicator"
            android:visibility="invisible" />
    </LinearLayout>

    <!-- Messages -->
    <LinearLayout
        android:id="@+id/nav_prop_messages"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ic_nav_prop_messages"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chat"
            app:tint="#64748B" />

        <TextView
            android:id="@+id/tv_nav_prop_messages"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Messages"
            android:textColor="#64748B"
            android:textSize="12sp" />

        <View
            android:id="@+id/indicator_nav_prop_messages"
            android:layout_width="56dp"
            android:layout_height="3dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_nav_indicator"
            android:visibility="invisible" />
    </LinearLayout>

    <!-- Profil -->
    <LinearLayout
        android:id="@+id/nav_prop_profil"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ic_nav_prop_profil"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_person"
            app:tint="#64748B" />

        <TextView
            android:id="@+id/tv_nav_prop_profil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Profil"
            android:textColor="#64748B"
            android:textSize="12sp" />

        <View
            android:id="@+id/indicator_nav_prop_profil"
            android:layout_width="56dp"
            android:layout_height="3dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_nav_indicator"
            android:visibility="invisible" />
    </LinearLayout>

</LinearLayout>