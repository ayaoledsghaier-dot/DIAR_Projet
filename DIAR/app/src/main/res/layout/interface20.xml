<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F8FAFC">
    <!--  En-tête : flèche retour + titre  -->
    <LinearLayout android:id="@+id/headerLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="20dp" android:paddingTop="16dp" android:paddingBottom="12dp" app:layout_constraintTop_toTopOf="parent">
        <ImageButton android:id="@+id/btnBack" android:layout_width="40dp" android:layout_height="40dp" android:background="?attr/selectableItemBackgroundBorderless" android:scaleType="centerInside" android:src="@drawable/baseline_arrow_back_24" app:tint="#1E2A5A" tools:ignore="ContentDescription"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Demandes des étudiants" android:textColor="#1E2A5A" android:textSize="19sp" android:textStyle="bold"/>
    </LinearLayout>
    <!--  Onglets  -->
    <LinearLayout android:id="@+id/tabsLayout" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginTop="4dp" android:layout_marginEnd="16dp" android:background="@drawable/bg_tabs_container" android:orientation="horizontal" android:padding="6dp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@+id/headerLayout">
        <!--  En attente (actif)  -->
        <LinearLayout android:id="@+id/tabEnAttente" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_tab_active" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical" android:paddingVertical="10dp">
            <TextView android:id="@+id/tvTabEnAttente" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="En attente" android:textColor="#1B8A5A" android:textSize="14sp" android:textStyle="bold"/>
            <View android:layout_width="36dp" android:layout_height="3dp" android:layout_marginTop="5dp" android:background="@drawable/bg_nav_indicator"/>
        </LinearLayout>
        <!--  Acceptées  -->
        <LinearLayout android:id="@+id/tabAcceptees" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical" android:paddingVertical="10dp">
            <TextView android:id="@+id/tvTabAcceptees" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Acceptées" android:textColor="#64748B" android:textSize="14sp"/>
        </LinearLayout>
        <!--  Refusées  -->
        <LinearLayout android:id="@+id/tabRefusees" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical" android:paddingVertical="10dp">
            <TextView android:id="@+id/tvTabRefusees" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Refusées" android:textColor="#64748B" android:textSize="14sp"/>
        </LinearLayout>
    </LinearLayout>
    <!--  Liste des demandes  -->
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:fillViewport="true" android:scrollbars="none" app:layout_constraintBottom_toTopOf="@+id/bottomNavigation" app:layout_constraintTop_toBottomOf="@+id/tabsLayout">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <!--  Carte 1 : Ahmed  -->
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="20dp" app:cardElevation="3dp" app:strokeColor="#F1F5F9" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp">
                    <com.google.android.material.card.MaterialCardView android:layout_width="60dp" android:layout_height="60dp" app:cardBackgroundColor="#DDF3E8" app:cardCornerRadius="30dp" app:cardElevation="0dp" app:strokeWidth="0dp">
                        <!--  Remplace src par la photo et retire padding + tint  -->
                        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:padding="14dp" android:scaleType="centerCrop" android:src="@drawable/ic_person" app:tint="#1B8A5A"/>
                    </com.google.android.material.card.MaterialCardView>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ahmed" android:textColor="#1E2A5A" android:textSize="16sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="21 ans • ISITCOM" android:textColor="#64748B" android:textSize="13sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Demande de visite" android:textColor="#1B8A5A" android:textSize="14sp" android:textStyle="bold"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnAccepter1" android:layout_width="0dp" android:layout_height="42dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:text="Accepter" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" app:backgroundTint="#1B8A5A" app:cornerRadius="21dp" app:elevation="0dp"/>
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnRefuser1" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="42dp" android:layout_marginStart="6dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:text="Refuser" android:textAllCaps="false" android:textColor="#EF4444" android:textSize="13sp" app:backgroundTint="#FFFFFF" app:cornerRadius="21dp" app:strokeColor="#FCA5A5" app:strokeWidth="1dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!--  Carte 2 : Mariem  -->
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="20dp" app:cardElevation="3dp" app:strokeColor="#F1F5F9" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp">
                    <com.google.android.material.card.MaterialCardView android:layout_width="60dp" android:layout_height="60dp" app:cardBackgroundColor="#DDF3E8" app:cardCornerRadius="30dp" app:cardElevation="0dp" app:strokeWidth="0dp">
                        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:padding="14dp" android:scaleType="centerCrop" android:src="@drawable/ic_person" app:tint="#1B8A5A"/>
                    </com.google.android.material.card.MaterialCardView>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mariem" android:textColor="#1E2A5A" android:textSize="16sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="20 ans • Université de Sousse" android:textColor="#64748B" android:textSize="13sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Demande de contact" android:textColor="#1B8A5A" android:textSize="14sp" android:textStyle="bold"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnAccepter2" android:layout_width="0dp" android:layout_height="42dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:text="Accepter" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" app:backgroundTint="#1B8A5A" app:cornerRadius="21dp" app:elevation="0dp"/>
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnRefuser2" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="42dp" android:layout_marginStart="6dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:text="Refuser" android:textAllCaps="false" android:textColor="#EF4444" android:textSize="13sp" app:backgroundTint="#FFFFFF" app:cornerRadius="21dp" app:strokeColor="#FCA5A5" app:strokeWidth="1dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!--  Carte 3 : Yassine  -->
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="20dp" app:cardElevation="3dp" app:strokeColor="#F1F5F9" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp">
                    <com.google.android.material.card.MaterialCardView android:layout_width="60dp" android:layout_height="60dp" app:cardBackgroundColor="#DDF3E8" app:cardCornerRadius="30dp" app:cardElevation="0dp" app:strokeWidth="0dp">
                        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:padding="14dp" android:scaleType="centerCrop" android:src="@drawable/ic_person" app:tint="#1B8A5A"/>
                    </com.google.android.material.card.MaterialCardView>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Yassine" android:textColor="#1E2A5A" android:textSize="16sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="22 ans • ISITCOM" android:textColor="#64748B" android:textSize="13sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Demande de visite" android:textColor="#1B8A5A" android:textSize="14sp" android:textStyle="bold"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnAccepter3" android:layout_width="0dp" android:layout_height="42dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:text="Accepter" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" app:backgroundTint="#1B8A5A" app:cornerRadius="21dp" app:elevation="0dp"/>
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnRefuser3" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="42dp" android:layout_marginStart="6dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:text="Refuser" android:textAllCaps="false" android:textColor="#EF4444" android:textSize="13sp" app:backgroundTint="#FFFFFF" app:cornerRadius="21dp" app:strokeColor="#FCA5A5" app:strokeWidth="1dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <!--  Barre de navigation du bas  -->
    <include android:id="@+id/bottomNavigationProprietaire" layout="@layout/interface_barre_proprietaire" android:layout_width="0dp" android:layout_height="70dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>