<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC"
    android:orientation="vertical">

    <!-- En-tête -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/btnRetourMessages"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Retour"
            android:scaleType="centerInside"
            android:src="@drawable/baseline_arrow_back_24"
            app:tint="#1E2A5A" />

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_circle_green_light"
            android:importantForAccessibility="no"
            android:padding="10dp"
            android:src="@drawable/ic_person"
            app:tint="#1B8A5A" />

        <TextView
            android:id="@+id/tvNomEtudiant"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Nom étudiant"
            android:textColor="#1E2A5A"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Messages -->
    <ScrollView
        android:id="@+id/scrollMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutMessages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginEnd="48dp"
                android:background="@drawable/bg_bubble_received"
                android:maxWidth="280dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:text="Bonjour, je suis intéressé par votre annonce."
                android:textColor="#1E2A5A"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginStart="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_bubble_sent"
                android:maxWidth="280dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:text="Bonjour ! Bienvenue, comment puis-je vous aider ?"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

        </LinearLayout>
    </ScrollView>

    <!-- Zone de saisie -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <EditText
            android:id="@+id/edtMessage"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_message"
            android:hint="Écrire un message..."
            android:paddingHorizontal="18dp"
            android:singleLine="true"
            android:textColor="#1E2A5A"
            android:textColorHint="#94A3B8"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnEnvoyerMessage"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#1B8A5A"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="22dp"
            android:text="Envoyer"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="24dp" />
    </LinearLayout>

</LinearLayout>