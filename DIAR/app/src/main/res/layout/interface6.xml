<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- En-tête : Flèche retour + Titre -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Retour"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#0F172A" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Mes préférences"
            android:textColor="#0F172A"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/btnBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btnBack"
            app:layout_constraintTop_toTopOf="@+id/btnBack" />

        <!-- Section 1 : Type de logement -->
        <TextView
            android:id="@+id/lblTypeLogement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Type de logement"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnBack" />

        <!-- Grille Type de Logement -->
        <LinearLayout
            android:id="@+id/layoutTypes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/lblTypeLogement">

            <!-- Studio -->
            <LinearLayout
                android:id="@+id/layoutStudio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardStudio"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="#F8FAFC">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="🏢" android:textSize="24sp" />
                </com.google.android.material.card.MaterialCardView>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Studio" android:textColor="#64748B" android:textSize="11sp" />
            </LinearLayout>

            <!-- Appartement -->
            <LinearLayout
                android:id="@+id/layoutAppartement"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAppartement"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="#F8FAFC">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="🏙️" android:textSize="24sp" />
                </com.google.android.material.card.MaterialCardView>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Appartement" android:textColor="#64748B" android:textSize="11sp" />
            </LinearLayout>

            <!-- Chambre -->
            <LinearLayout
                android:id="@+id/layoutChambre"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardChambre"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="#F8FAFC">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="🛏️" android:textSize="24sp" />
                </com.google.android.material.card.MaterialCardView>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Chambre" android:textColor="#64748B" android:textSize="11sp" />
            </LinearLayout>

            <!-- Maison (Neutre au départ) -->
            <LinearLayout
                android:id="@+id/layoutMaison"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMaison"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="#F8FAFC">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="🏠" android:textSize="24sp" />
                </com.google.android.material.card.MaterialCardView>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Maison" android:textColor="#64748B" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Section 2 : Location -->
        <TextView
            android:id="@+id/lblLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Location"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutTypes" />

        <LinearLayout
            android:id="@+id/layoutLocationOpts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/lblLocation">

            <!-- Individuelle -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardIndividuelle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#F8FAFC">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👤" android:textSize="16sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Individuelle" android:textColor="#64748B" android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Colocation (Neutre au départ) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardColocation"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#F8FAFC">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👥" android:textSize="16sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Colocation" android:textColor="#64748B" android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Section 3 : Budget Maximal -->
        <TextView
            android:id="@+id/lblBudget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Budget maximal (DT/mois)"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutLocationOpts" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilBudget"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="#00A86B"
            app:hintTextColor="#00A86B"
            app:layout_constraintTop_toBottomOf="@+id/lblBudget">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBudget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="max : 500DT"
                android:inputType="number"
                android:textColor="@color/black"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Section 4 : Équipements -->
        <TextView
            android:id="@+id/lblEquipements"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Équipements"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tilBudget" />

        <!-- Checkboxes en 2 colonnes -->
        <LinearLayout
            android:id="@+id/layoutCheckboxContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/lblEquipements">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbWifi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:text="Wi-Fi"
                    android:textColor="#475569"
                    android:textSize="13sp"
                    app:buttonTint="#00A86B" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbClim"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:text="Climatisation"
                    android:textColor="#475569"
                    android:textSize="13sp"
                    app:buttonTint="#00A86B" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbChauffage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:text="Chauffage"
                    android:textColor="#475569"
                    android:textSize="13sp"
                    app:buttonTint="#00A86B" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbCuisine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:text="Cuisine équipée"
                    android:textColor="#475569"
                    android:textSize="13sp"
                    app:buttonTint="#00A86B" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbMachineLaver"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:text="Machine à laver"
                    android:textColor="#475569"
                    android:textSize="13sp"
                    app:buttonTint="#00A86B" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbParking"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:text="Parking"
                    android:textColor="#475569"
                    android:textSize="13sp"
                    app:buttonTint="#00A86B" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbSalleDeBain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:text="Salle de bain privée"
                    android:textColor="#475569"
                    android:textSize="13sp"
                    app:buttonTint="#00A86B" />
            </LinearLayout>
        </LinearLayout>

        <!-- Section 5 : Quartiers préférés -->
        <TextView
            android:id="@+id/lblQuartiers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Quartiers préférés"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutCheckboxContainer" />

        <LinearLayout
            android:id="@+id/layoutQuartiers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/lblQuartiers">

            <!-- Sahloul (Neutre au départ) -->
            <TextView
                android:id="@+id/chipSahloul"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_unselected"
                android:paddingHorizontal="16dp"
                android:paddingVertical="7dp"
                android:text="Sahloul"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:layout_marginEnd="8dp" />

            <!-- Khezema -->
            <TextView
                android:id="@+id/chipKhezema"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_unselected"
                android:paddingHorizontal="16dp"
                android:paddingVertical="7dp"
                android:text="Khezema"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:layout_marginEnd="8dp" />

            <!-- Bouhdima -->
            <TextView
                android:id="@+id/chipBouhdima"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_unselected"
                android:paddingHorizontal="16dp"
                android:paddingVertical="7dp"
                android:text="Bouhdima"
                android:textColor="#64748B"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Bouton Enregistrer -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnregistrer"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#00A86B"
            android:text="Enregistrer"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:elevation="0dp"
            app:layout_constraintTop_toBottomOf="@+id/layoutQuartiers"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>