<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Bouton Retour -->
        <Button
            android:id="@+id/btnRetourDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Retour"
            android:backgroundTint="#315C46"
            android:textColor="#FFFFFF" />

        <!-- Photo principale -->
        <ImageView
            android:id="@+id/imgDetailAnnonce"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="16dp"
            android:scaleType="centerCrop"
            android:src="@drawable/appart"
            android:contentDescription="Photo de l'annonce" />

        <!-- Galerie des photos -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutPhotos"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical" />

        </HorizontalScrollView>

        <!-- Titre -->
        <TextView
            android:id="@+id/tvDetailTitre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Titre de l'annonce"
            android:textColor="#222222"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Prix -->
        <TextView
            android:id="@+id/tvDetailPrix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="0 DT"
            android:textColor="#315C46"
            android:textSize="22sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="#DDDDDD" />

        <!-- Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textColor="#222222"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDetailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Description"
            android:textColor="#555555"
            android:textSize="16sp" />

        <!-- Nombre de personnes -->
        <TextView
            android:id="@+id/tvDetailPersonnes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Nombre de personnes"
            android:textColor="#333333"
            android:textSize="16sp" />

        <!-- Localisation -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Localisation"
            android:textColor="#222222"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDetailLatitude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Latitude"
            android:textColor="#555555"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvDetailLongitude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Longitude"
            android:textColor="#555555"
            android:textSize="15sp" />

        <!-- Carte -->
        <org.osmdroid.views.MapView
            android:id="@+id/mapDetailAnnonce"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="16dp" />

        <!-- Bouton Supprimer -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSupprimerAnnonce"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp"
            android:text="Supprimer cette annonce"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#D32F2F"
            app:cornerRadius="14dp" />

    </LinearLayout>

</ScrollView>
