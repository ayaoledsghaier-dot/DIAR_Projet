<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <!-- En-tête -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="18dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Retour"
            android:scaleType="centerInside"
            android:src="@drawable/arrow_back"
            android:tint="#0B132B"
            tools:ignore="UseAppTint" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ajouter une annonce"
                android:textColor="#0B132B"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Présentez votre logement"
                android:textColor="#64748B"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Barre de progression -->
    <View
        android:id="@+id/progressBackground"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:background="#DDE7E7"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:background="#00796B"
        app:layout_constraintWidth_percent="0.5"
        app:layout_constraintTop_toTopOf="@id/progressBackground"
        app:layout_constraintBottom_toBottomOf="@id/progressBackground"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Contenu défilant -->
    <ScrollView
        android:id="@+id/scrollForm"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/progressBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="28dp">

            <!-- Section photos -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Photos du logement"
                android:textColor="#0B132B"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Ajoutez des photos pour attirer les étudiants."
                android:textColor="#64748B"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btnUploadPhoto"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="14dp"
                android:background="#E0F2F1"
                android:contentDescription="Ajouter des photos"
                android:scaleType="centerInside"
                android:src="@drawable/icon_camera_profil" />

            <!-- Informations générales -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Informations générales"
                android:textColor="#0B132B"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Titre -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Titre de l'annonce *"
                android:textColor="#334155"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etTitre"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="Ex. : Appartement à Sahloul"
                android:textColor="#0B132B"
                android:textColorHint="#94A3B8"
                android:textSize="14sp"
                android:singleLine="true"
                android:inputType="textCapSentences" />

            <!-- Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Description *"
                android:textColor="#334155"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:gravity="top|start"
                android:padding="14dp"
                android:hint="Décrivez le logement, les équipements, la proximité de l'université..."
                android:textColor="#0B132B"
                android:textColorHint="#94A3B8"
                android:textSize="14sp"
                android:inputType="textMultiLine|textCapSentences"
                android:scrollbars="vertical" />

            <!-- Prix -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Prix mensuel (DT) *"
                android:textColor="#334155"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#FFFFFF"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <EditText
                    android:id="@+id/etPrix"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Ex. : 350"
                    android:textColor="#0B132B"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp"
                    android:inputType="numberDecimal"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DT / mois"
                    android:textColor="#00796B"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Adresse -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Adresse du logement *"
                android:textColor="#334155"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etAdresse"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="Ex. : Sahloul, Sousse"
                android:textColor="#0B132B"
                android:textColorHint="#94A3B8"
                android:textSize="14sp"
                android:singleLine="true"
                android:inputType="textCapSentences" />

            <!-- Bouton suivant -->
            <Button
                android:id="@+id/btnNext"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="28dp"
                android:backgroundTint="#00796B"
                android:text="Continuer"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="* Champs obligatoires"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>